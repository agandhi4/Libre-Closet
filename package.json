{
  "name": "closet",
  "version": "0.5.1",
  "description": "Private household wardrobe organizer: garments, outfits, and a calendar.",
  "author": "Aakash Gandhi",
  "private": true,
  "license": "AGPL-3.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run generate",
    "generate": "npm run generate:build-info && npm run generate:tailwind && npm run generate:sw",
    "generate:build-info": "ts-node scripts/write-build-info.ts",
    "generate:vendor": "npm run generate:fonts",
    "generate:fonts": "node -e \"require('fs').rmSync('public/vendor/fonts', { recursive: true, force: true })\" && esbuild --outfile=public/vendor/fonts/fonts.css --bundle --minify --log-level=warning --loader:.woff2=file --asset-names=[name]-[hash] --public-path=/vendor/fonts views/assets/fonts.css",
    "generate:sw": "esbuild --outfile=views/assets/src-sw.js --bundle --minify --define:process.env.NODE_ENV=\\\"production\\\" views/assets/src-sw.ts && npx workbox injectManifest",
    "generate:sw:watch": "npx workbox injectManifest --watch",
    "generate:tailwind": "npm run generate:vendor && npx @tailwindcss/cli -i ./views/assets/main.css -o ./public/bundle.css --minify",
    "generate:tailwind:watch": "npm run generate:vendor && npx @tailwindcss/cli -i ./views/assets/main.css -o ./public/bundle.css --minify --watch",
    "generate:icons": "ts-node scripts/generate-icons.ts",
    "format": "prettier --write \"{src,test,scripts}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check --cache \"{src,test,scripts}/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json --tsBuildInfoFile node_modules/.cache/closet/tsc.tsbuildinfo && tsc -p views/assets/tsconfig.json",
    "start": "npm run build && node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && concurrently \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\" \"npm run generate:tailwind:watch\"",
    "start:debug": "tsc -p tsconfig.build.json && concurrently \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --inspect --watch dist/main.js\" \"npm run generate:tailwind:watch\"",
    "start:prod": "node dist/main.js",
    "start:test": "node -r ts-node/register/transpile-only test/support/test-server.ts",
    "maintenance:reconcile": "node dist/maintenance/reconcile.cli.js",
    "user:set-password": "node dist/maintenance/set-password.cli.js",
    "push:revoke-all": "node dist/maintenance/revoke-push.cli.js",
    "cutout:fetch-model": "node dist/cutout/fetch-model.cli.js",
    "seed": "node dist/seed/seed.cli.js",
    "lighthouse": "lhci autorun",
    "lint": "eslint \"{src,test,scripts}/**/*.{ts,tsx}\" --fix",
    "test": "vitest run --project 'unit*'",
    "test:watch": "vitest --project 'unit*'",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest run --inspect-brk --no-file-parallelism",
    "test:int": "vitest run --project integration",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:smoke": "npm run build && playwright test test/smoke.spec.ts --project=chromium",
    "postinstall": "patch-package",
    "test:load": "ts-node scripts/load-test.ts",
    "test:load:baseline": "ts-node scripts/load-test.ts --baseline",
    "test:load:compare": "ts-node scripts/load-test.ts --compare",
    "precommit": "npm run check",
    "precommit:full": "npm run check && npm run verify:push && npm run test:load && npm run lighthouse",
    "test:all": "vitest run",
    "lint:check": "eslint --cache --cache-location node_modules/.cache/closet/eslint \"{src,test,scripts}/**/*.{ts,tsx}\"",
    "docs:check": "node -r ts-node/register/transpile-only scripts/check-claude-md.ts",
    "check": "concurrently --group --kill-others-on-fail --names static,tests \"npm:check:static\" \"npm:test:all\"",
    "check:static": "concurrently --group --kill-others-on-fail --names docs,format,lint,types \"npm:docs:check\" \"npm:format:check\" \"npm:lint:check\" \"npm:typecheck\"",
    "prepare": "node -e \"require('fs').existsSync('.git') && require('child_process').execSync('git config core.hooksPath .githooks')\"",
    "verify:push": "npm run build && playwright test --project=chromium"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.4",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@khmyznikov/pwa-install": "^0.7.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@sinclair/typebox": "^0.34.52",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "5.11.3",
    "heic-decode": "^2.1.0",
    "hono": "^4.13.9",
    "htmx.org": "^2.0.7",
    "jsonwebtoken": "^9.0.3",
    "onnxruntime-node": "1.21.0",
    "patch-package": "^8.0.1",
    "pg": "8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.2",
    "pulltorefreshjs": "^0.1.22",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "workbox-window": "^7.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@mikro-orm/core": "^6.6.14",
    "@mikro-orm/migrations": "^6.5.8",
    "@mikro-orm/postgresql": "^6.6.14",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/cli": "^4.1.14",
    "@types/autocannon": "^7.12.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "~4.0.18",
    "autocannon": "^8.0.0",
    "concurrently": "^9.2.1",
    "daisyui": "^5.1.27",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.11",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "~4.0.18",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-cli": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.4.1",
    "workbox-navigation-preload": "^7.4.1",
    "workbox-precaching": "^7.3.0",
    "workbox-recipes": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  }
}
