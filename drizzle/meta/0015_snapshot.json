        "garment_type_check": {
          "name": "garment_type_check",
          "value": "\"garment\".\"type\" in ('t-shirt', 'long-sleeve-tee', 'shirt', 'polo', 'blouse', 'tank', 'sweater', 'cardigan', 'hoodie', 'sweatshirt', 'turtleneck', 'jeans', 'chinos', 'trousers', 'joggers', 'sweatpants', 'shorts', 'skirt', 'leggings', 'day-dress', 'evening-dress', 'jumpsuit', 'jacket', 'denim-jacket', 'leather-jacket', 'blazer', 'coat', 'parka', 'puffer', 'trench', 'rain-jacket', 'vest', 'fleece', 'sneakers', 'running-shoes', 'boots', 'loafers', 'dress-shoes', 'sandals', 'slides', 'heels', 'hat', 'cap', 'beanie', 'scarf', 'gloves', 'belt', 'sunglasses', 'tie', 'jewelry', 'watch', 'backpack', 'tote', 'crossbody', 'handbag', 'duffel')"
        },
        "garment_warmth_check": {
          "name": "garment_warmth_check",
          "value": "\"garment\".\"warmth\" in (1, 2, 3, 4, 5)"
        },
        "garment_formality_check": {
          "name": "garment_formality_check",
          "value": "\"garment\".\"formality\" in (1, 2, 3, 4)"
        },
        "garment_materials_check": {
          "name": "garment_materials_check",
          "value": "\"garment\".\"materials\" <@ array['cotton', 'linen', 'wool', 'merino', 'cashmere', 'silk', 'denim', 'leather', 'suede', 'polyester', 'nylon', 'fleece', 'down', 'knit', 'synthetic', 'other']::text[] and cardinality(\"garment\".\"materials\") > 0"
        },
        "garment_pattern_check": {
          "name": "garment_pattern_check",
          "value": "\"garment\".\"pattern\" in ('solid', 'stripes', 'check', 'print', 'graphic', 'floral', 'other')"
        },
        "garment_fit_check": {
          "name": "garment_fit_check",
          "value": "\"garment\".\"fit\" in ('slim', 'regular', 'relaxed', 'oversized')"
        },
        "garment_sleeve_check": {
          "name": "garment_sleeve_check",
          "value": "\"garment\".\"sleeve\" in ('sleeveless', 'short', 'three-quarter', 'long')"
        },
        "garment_length_check": {
          "name": "garment_length_check",
          "value": "\"garment\".\"length\" in ('short', 'knee', 'midi', 'full')"
        },
        "garment_source_url_check": {
          "name": "garment_source_url_check",
          "value": "\"garment\".\"source_url\" ~* '^https?://'"
        },
        "garment_price_check": {
          "name": "garment_price_check",
          "value": "\"garment\".\"price\" >= 0"
        },
        "garment_quantity_check": {
          "name": "garment_quantity_check",
          "value": "\"garment\".\"quantity\" between 1 and 30"
        },
        "garment_wash_after_wears_check": {
          "name": "garment_wash_after_wears_check",
          "value": "\"garment\".\"wash_after_wears\" between 0 and 20"
        },
        "garment_away_check": {
          "name": "garment_away_check",
          "value": "\"garment\".\"away\" in ('lent', 'repair')"
        },
        "garment_away_note_check": {
          "name": "garment_away_note_check",
          "value": "\"garment\".\"away_note\" is null or \"garment\".\"away\" is not null"
        },
        "garment_condition_check": {
          "name": "garment_condition_check",
          "value": "\"garment\".\"condition\" in ('good', 'needs_repair', 'replace_soon')"
        },
        "garment_condition_note_check": {
          "name": "garment_condition_note_check",
          "value": "\"garment\".\"condition_note\" is null or \"garment\".\"condition\" <> 'good'"
        },
        "garment_fabric_weight_check": {
          "name": "garment_fabric_weight_check",
          "value": "\"garment\".\"fabric_weight\" between 20 and 1200"
        },
        "garment_status_check": {
          "name": "garment_status_check",
          "value": "\"garment\".\"status\" in ('wishlist', 'closet', 'archived')"
        },
        "garment_replaces_garment_id_check": {
          "name": "garment_replaces_garment_id_check",
          "value": "\"garment\".\"replaces_garment_id\" <> \"garment\".\"id\""
        }
      },
      "isRLSEnabled": false
    },
