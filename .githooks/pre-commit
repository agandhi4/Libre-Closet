#!/bin/sh
# Installed by `npm install` (package.json "prepare" sets core.hooksPath).
# `npm run check`: format, lint, types and both Vitest tiers, in parallel. The
# integration tier needs Postgres: pgvault-dev on localhost:5432 or
# TEST_DATABASE_URL. scripts/git-hook.ts keeps each half's output in a log and
# prints one line per half, or a failed half's tail (docs/git-hooks.md). Bypass
# only with intent: git commit --no-verify.
exec node -r ts-node/register/transpile-only scripts/git-hook.ts pre-commit
